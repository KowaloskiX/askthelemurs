# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=        # router, planner, policy spec, data agent (gpt-5.4 / gpt-5.4-mini)
TYPESAFE_API_KEY=      # Jev, the residents' decision model
BDL_KEY=               # GUS BDL API, free: https://bdl.stat.gov.pl/api/v1/client (only for `make data`)

# Optional, for a public deployment
# KS_ORIGINS=https://your-frontend.example   # comma-separated CORS origins
# KS_LIMIT_IP=30                             # questions per IP per hour
# KS_LIMIT_DAY=500                           # questions per day in total
# KS_JEV_CONC=40                             # parallel Jev calls
# KS_EFFORT=low                              # reasoning effort for gpt-5.4
